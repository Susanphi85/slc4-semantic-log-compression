# Build artefacts
/dist/
/build/
node_modules/

# Toolchain fetched for the Total Commander plugin build (~380 MB).
# Recreate with the instructions in the README; never commit it.
/tools/

# Test data. Log samples are the raw material of this project and are very
# likely to contain production values -- addresses, URLs, identifiers, payloads.
# Nothing under test/ is committed; use fixtures/ for synthetic data instead.
/test/
*.slc4z
*.ndjson
downloaded-logs-*.json

# ...except the small synthetic archives under examples/, which are committed
# on purpose so the plugin and the CLI have something to open immediately.
!examples/*.slc4z

# Staging area for release assets. Binaries are published as release
# attachments rather than committed: slc4.exe is 90 MB, every rebuild produces
# a completely different blob, and git would keep all of them forever.
/release/

# The PDF is generated from docs/research.pl.md and goes stale the moment the
# source changes, so it is built on demand rather than tracked.
*.pdf

# Editor and OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp
